# Exclude source, dev tooling, and build artifacts — keep node_modules for solc
.vscode/**
src/**
runner/**
examples/**
docs/**
scripts/**
releases/**

# TypeScript / build config
tsconfig.json
webpack.config.js
jest.config.js
commitlint.config.js
.eslintrc*
eslint.config.js
.prettierrc*
.editorconfig

# Dev files (vsce matches with minimatch — `*` does not cross `/`, so use `**/`)
*.ts
**/*.ts
**/*.map
bun.lock
future.md
tsconfig.webview.json
.husky/**
.gitignore
.git/**
ARCHITECTURE.md
Claude.md
Features.md
Implementation.md
forge-gas-example.md
install
install-dev.sh
CHANGELOG.md
CONTRIBUTING.md

# Test files
**/__tests__/**
**/*.test.*
**/*.spec.*

# node_modules: packaged with `vsce package --no-dependencies` because the repo uses
# bun, whose node_modules layout vsce's npm-based dependency walker can't read. Before
# packaging, node_modules is reinstalled production-only (`bun install --production`),
# so only runtime deps remain here — chiefly `solc`, a webpack external that
# SolcManager lazily `require()`s at runtime. Just trim bun's internal dirs.
node_modules/.bin/**
node_modules/.cache/**
